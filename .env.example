# ── LLM API ───────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# ── Tool paths ────────────────────────────────────────────
DAFNY_PATH=/usr/local/bin/dafny
CLANG_PATH=/usr/bin/clang-17
BPFTOOL_PATH=/usr/sbin/bpftool

# ── Pipeline config ───────────────────────────────────────
MAX_ITERATIONS=10
DAFNY_VERIFY_TIMEOUT=120
FUZZ_DURATION_SECONDS=60

# ── Debug ─────────────────────────────────────────────────
DEBUG_INVARIANTS=1
LOG_LEVEL=INFO
